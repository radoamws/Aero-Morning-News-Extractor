APP_NAME="Aero Morning News Extractor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# CORS (allowed origins for browser calls to /api/*)
# Production example:
# CORS_ALLOWED_ORIGINS=https://news.aeromorning.com
CORS_ALLOWED_ORIGINS=*

# If you ever switch to Sanctum cookie-based SPA auth, set these too:
# SANCTUM_STATEFUL_DOMAINS=news.aeromorning.com,news.api.aeromorning.com
# SESSION_DOMAIN=.aeromorning.com

# WordPress Configuration
WORDPRESS_URL=https://aeromorning.com
WORDPRESS_FR_URL=https://aeromorning.com
WORDPRESS_EN_URL=https://aeromorning.com/en
# WordPress Application Password (Base64 encoded user:password)
WORDPRESS_AUTH_FR=your-base64-wp-app-password-fr
WORDPRESS_AUTH_EN=your-base64-wp-app-password-en

# Notification email for publish summary
NOTIFY_EMAIL=rado.rakotoarivelo@amws.space

# Mail Configuration (SMTP)
# For Gmail: use app password (https://support.google.com/accounts/answer/185833)
# For Outlook: smtp-mail.outlook.com:587 with tls
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=news@aeromorning.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="news@aeromorning.com"
MAIL_FROM_NAME="${APP_NAME}"

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=extract_news
DB_USERNAME=root
DB_PASSWORD=

# IMAP Configuration
IMAP_HOST=your-imap-host.com
IMAP_PORT=993
IMAP_USERNAME=your-email@example.com
IMAP_PASSWORD=your-imap-password
IMAP_ENCRYPTION=ssl

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Default admin account (used by seeder)
ADMIN_DEFAULT_NAME=admin
ADMIN_DEFAULT_EMAIL=admin@aeromorning.local
ADMIN_DEFAULT_PASSWORD=admin123

# Image Processing
IMAGE_MAX_SIZE=1000000
IMAGE_WIDTH=700
IMAGE_HEIGHT=400
IMAGE_BACKGROUND_COLOR=#005A8C
IMAGE_FORMAT=jpg
IMAGE_QUALITY=85

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
