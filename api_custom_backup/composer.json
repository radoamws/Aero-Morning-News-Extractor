{
    "name": "aeromorning/extract-news",
    "description": "Laravel API for extracting aviation news from emails and syncing to WordPress",
    "type": "project",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.8",
        "guzzlehttp/guzzle": "^7.2",
        "openai-php/client": "^0.8",
        "php-imap/php-imap": "^5.0.1",
        "intervention/image": "^3.0",
        "php-curl-class/php-curl-class": "^9.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"if (file_exists('artisan')) { passthru('php artisan package:discover --ansi'); }\""
        ],
        "post-update-cmd": [
            "@php -r \"if (file_exists('artisan')) { passthru('php artisan vendor:publish --tag=laravel-assets --ansi --force'); }\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"if (file_exists('artisan')) { passthru('php artisan key:generate --ansi'); }\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
